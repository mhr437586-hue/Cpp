
#include <iostream>
using namespace std;

int main()
{
    int A[3][3], B[3][3], C[3][3];
    int i, j, k;

    // Input Matrix A
    for(i = 0; i < 3; i++)
        for(j = 0; j < 3; j++)
        {
            cout << "Enter value for Matrix A: ";
            cin >> A[i][j];
        }

    // Input Matrix B
    for(i = 0; i < 3; i++)
        for(j = 0; j < 3; j++)
        {
            cout << "Enter value for Matrix B: ";
            cin >> B[i][j];
        }

    // Initialize Matrix C
    for(i = 0; i < 3; i++)
        for(j = 0; j < 3; j++)
            C[i][j] = 0;

    // Display Matrix A
    cout << "\nMatrix A:\n";
    for(i = 0; i < 3; i++)
    {
        for(j = 0; j < 3; j++)
            cout << A[i][j] << "\t";
        cout << endl;
    }

    // Display Matrix B
    cout << "\nMatrix B:\n";
    for(i = 0; i < 3; i++)
    {
        for(j = 0; j < 3; j++)
            cout << B[i][j] << "\t";
        cout << endl;
    }

    // Matrix Multiplication
    for(i = 0; i < 3; i++)
        for(j = 0; j < 3; j++)
            for(k = 0; k < 3; k++)
                C[i][j] += A[i][k] * B[k][j];

    // Output Result
    cout << "\nProduct of Matrix A and B:\n";
    for(i = 0; i < 3; i++)
    {
        for(j = 0; j < 3; j++)
            cout << C[i][j] << "\t";
        cout << endl;
    }

    return 0;
}


