#include <iostream>
using namespace std;

int main()
{
    int A[3][3], B[3][3], C[3][3];
    int i, j, k;

    // Input matrix A
    cout << "Enter values of Matrix A:\n";
    for (i = 0; i < 3; i++)
    {
        for (j = 0; j < 3; j++)
        {
            cin >> A[i][j];
        }
    }

    // Input matrix B
    cout << "Enter values of Matrix B:\n";
    for (i = 0; i < 3; i++)
    {
        for (j = 0; j < 3; j++)
        {
            cin >> B[i][j];
        }
    }

    // Initialize matrix C with 0
    for (i = 0; i < 3; i++)
    {
        for (j = 0; j < 3; j++)
        {
            C[i][j] = 0;
        }
    }

    // Matrix multiplication
    for (i = 0; i < 3; i++)
    {
        for (j = 0; j < 3; j++)
        {
            for (k = 0; k < 3; k++)
            {
                C[i][j] = C[i][j] + A[i][k] * B[k][j];
            }
        }
    }

    // Output matrix C
    cout << "Product of Matrix A and B is:\n";
    for (i = 0; i < 3; i++)
    {
        for (j = 0; j < 3; j++)
        {
            cout << C[i][j] << "\t";
        }
        cout << endl;
    }

    return 0;
}
