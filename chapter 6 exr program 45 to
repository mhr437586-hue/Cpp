#include <iostream>
using namespace std;

int main() {
    int start = 1;

    for(int i = 1; i <= 10; i++) {
        int num = start;

        // increasing
        for(int j = 1; j <= i; j++) {
            cout << num;
            num = (num + 1) % 10;
        }

        num = (num - 2 + 10) % 10;

        // decreasing
        for(int j = 1; j < i; j++) {
            cout << num;
            num = (num - 1 + 10) % 10;
        }

        cout << endl;
        start = (start + 1) % 10;
    }

    return 0;
}




