int main() {
    int n = 5;

    // Upper pyramid
    for(int i = 1; i <= n; i++) {
        for(int s = n; s > i; s--) {
            cout << " ";
        }
        for(int j = 1; j <= (2*i - 1); j++) {
            cout << "*";
        }
        cout << endl;
    }

    // Lower pyramid
    for(int i = n-1; i >= 1; i--) {
        for(int s = n; s > i; s--) {
            cout << " ";
        }
        for(int j = 1; j <= (2*i - 1); j++) {
            cout << "*";
        }
        cout << endl;
    }

    return 0;
}



