// 46. Count scores above 60
void program46() {
    int n, count = 0;
    while (true) {
        cin >> n;
        if (n == -1) break;
        if (n > 60) count++;
    }
    cout << "Above 60 = " << count << endl;
}

// 47. Frequency of positive and negative numbers
void program47() {
    int n, x, pos = 0, neg = 0;
    cin >> n;
    for (int i = 0; i < n; i++) {
        cin >> x;
        if (x > 0) pos++;
        else if (x < 0) neg++;
    }
    cout << "Positive=" << pos << " Negative=" << neg << endl;
}

