Program 8: Values Greater Than Average
#include <iostream>
using namespace std;

int main() {
    float arr[10], sum = 0, avg;

    for(int i = 0; i < 10; i++) {
        cin >> arr[i];
        sum += arr[i];
    }

    avg = sum / 10;

    cout << "Average = " << avg << endl;
    cout << "Values greater than average:\n";

    for(int i = 0; i < 10; i++) {
        if(arr[i] > avg)
            cout << arr[i] << " ";
    }
    return 0;
}

