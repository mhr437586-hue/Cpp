Program 5: Occurrence of Each Number
#include <iostream>
using namespace std;

int main() {
    int arr[10];

    cout << "Enter 10 numbers:\n";
    for(int i = 0; i < 10; i++)
        cin >> arr[i];

    for(int i = 0; i < 10; i++) {
        int count = 1;
        if(arr[i] == -1)
            continue;

        for(int j = i + 1; j < 10; j++) {
            if(arr[i] == arr[j]) {
                count++;
                arr[j] = -1;
            }
        }
        cout << arr[i] << " occurs " << count << " times\n";
    }
    return 0;
}

Program 6: Grades of Students
#include <iostream>
using namespace std;

int main() {
    int marks, A=0, B=0, C=0, F=0;

    for(int i = 0; i < 10; i++) {
        cout << "Enter marks: ";
        cin >> marks;

        if(marks >= 80) A++;
        else if(marks >= 60) B++;
        else if(marks >= 40) C++;
        else F++;
    }

    cout << "A Grade: " << A << endl;
    cout << "B Grade: " << B << endl;
    cout << "C Grade: " << C << endl;
    cout << "F Grade: " << F << endl;

    return 0;
}

Program 7: Fruit Bill System
