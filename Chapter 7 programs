Program 3: Squares, Cubes & Sums
#include <iostream>
using namespace std;

int main() {
    int numbers[5] = {1,2,3,4,5};
    int squares[5], cubes[5], sums[5], total = 0;

    for(int i = 0; i < 5; i++) {
        squares[i] = numbers[i] * numbers[i];
        cubes[i] = numbers[i] * numbers[i] * numbers[i];
        sums[i] = squares[i] + cubes[i];
        total += sums[i];
    }

    cout << "Sums Array:\n";
    for(int i = 0; i < 5; i++)
        cout << sums[i] << " ";

    cout << "\nTotal = " << total;
    return 0;
}

