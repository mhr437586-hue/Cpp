Program 59
Pyramid of Digits
Output:
1
232
34543
4567654
567898765
67890109876
7890123210987
890123454321098
90123456765432109
0123456789876543210

#include <iostream>
using namespace std;

int main() {
    int start = 1;

    for(int i = 1; i <= 10; i++) {
        int num = start;

        // increasing
        for(int j = 1; j <= i; j++) {
            cout << num;
            num = (num + 1) % 10;
        }

        num = (num - 2 + 10) % 10;

        // decreasing
        for(int j = 1; j < i; j++) {
            cout << num;
            num = (num - 1 + 10) % 10;
        }

        cout << endl;
        start = (start + 1) % 10;
    }

    return 0;
}


