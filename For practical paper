    Prime Number::>

#include <iostream>
using namespace std;
int main() {
   int n,i, z=0; 
   cout<<"Enter a number";
   cin>>n;
    for(i=2; i<n; i++)
     if(n%i==0)
     {
        z=1;
        break;
     }
     if(z==0)
     cout<<"its prime";
     else
     cout<<"not prime";
    return 0;
}

