 Sum of First N Numbers::>


#include<iostream>
using namespace std;

int main()
{
    int n, sum = 0;
    cout << "Enter a number: ";
    cin >> n;

    for(int i = 1; i <= n; i++)
        sum += i;

    cout << "Sum = " << sum;
    return 0;
}

