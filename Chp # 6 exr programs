
Program no.18
        Sum of series 1 + 2x + 3x^2 + 4x^3 + 5x^4

#include<iostream>
#include<cmath>
using namespace std;
int main() {
    int x;
    double sum = 0;
    cout << "Enter x: ";
    cin >> x;
    for(int i = 1; i <= 5; i++) {
        sum += i * pow(x, i-1);
    }
    cout << "Sum = " << sum;
    return 0;
}


Program no.19
         Sum of series 1 + 2 + 3x^2 + 4x^3 + 5x^4

#include<iostream>
#include<cmath>
using namespace std;
int main() {
    int x;
    double sum = 0;
    cout << "Enter x: ";
    cin >> x;
    sum = 1 + 2; // first two terms
    for(int i = 3; i <= 5; i++) {
        sum += i * pow(x, i-1);
    }
    cout << "Sum = " << sum;
    return 0;
}


Program no.20
         Sum of series 1/2 + 2/3 + 3/4 + ... + 99/100

#include<iostream>
using namespace std;
int main() {
    double sum = 0;
    for(int i = 1; i <= 99; i++) {
        sum += (double)i / (i+1);
    }
    cout << "Sum = " << sum;
    return 0;
}


Program no.21
         Print series 1024, 512, 256, ..., 1

#include<iostream>
using namespace std;
int main() {
    int n = 1024;
    while(n >= 1) {
        cout << n << " ";
        n /= 2;
    }
    return 0;
}


