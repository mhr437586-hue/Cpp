
Program no.18
        Program to calculate sum of series using for loop
            

#include <iostream>
#include <cmath>
using namespace std;
int main() {
    int x, n;
    double sum = 0;  
    cout << "Enter value of x: ";
    cin >> x;
    cout << "Enter value of n: ";
    cin >> n;
    for (int i = 1; i <= n; i++) {
        sum += pow(x, i); // x^i
    }
    cout << "Sum of series: " << sum << endl;
    return 0;
}


Program no.19
         Program to calculate sum of series

#include <iostream>
#include <cmath>
using namespace std;
int main() {
    int x, n;
    double sum = 0;
    cout << "Enter value of x: ";
    cin >> x;
    cout << "Enter number of terms n: ";
    cin >> n;
    for (int i = 1; i <= n; i++) {
        sum += i * pow(x, i-1); // i*x^(i-1)
    }
    cout << "Sum of series: " << sum << endl;
    return 0;
}


Program no.20
        Program to calculate sum of series

#include <iostream>
using namespace std;
int main() {
    int n;
    double sum = 0;
    cout << "Enter number of terms n: ";
    cin >> n;
    for (int i = 1; i <= n; i++) {
        sum += (double)i / (i + 1); // i/(i+1)
    }
    cout << "Sum of series: " << sum << endl;
    return 0;
}



Program no.21
         Program to print a sequence
           Sequence: 1024, 512, 256, 128, 64, 32, 16, 8, 4, 2, 1

#include <iostream>
using namespace std;
int main() {
    int num = 1024;
    while (num >= 1) {
        cout << num << " ";
        num /= 2; // divide by 2 each time
    }
    cout << endl;
    return 0;
}



Program no.22
        Program to print a sequence
            Sequence: 1, 3, 9, 27, 81, ..., 200

