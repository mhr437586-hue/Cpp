#include <iostream>
using namespace std;

int main() {
    int num, max, min, sum = 0;

    cout << "Enter number 1: ";
    cin >> num;
    max = min = num;
    sum = num;

    for(int i = 2; i <= 5; i++) {
        cout << "Enter number " << i << ": ";
        cin >> num;

        if(num > max) max = num;
        if(num < min) min = num;

        sum += num;
    }

    cout << "Largest = " << max << endl;
    cout << "Smallest = " << min << endl;
    cout << "Average = " << sum / 5.0 << endl;

    return 0;
}


Program no.6

#include <iostream>
using namespace std;

int main() {
    int countA = 0, countB = 0, countC = 0, countD = 0;
    char ans;

    for(int i = 1; i <= 20; i++) {
        cout << "Question " << i << " (A/B/C/D): ";
        cin >> ans;

        if(ans == 'A') countA++;
        else if(ans == 'B') countB++;
        else if(ans == 'C') countC++;
        else if(ans == 'D') countD++;
    }

    if(countA > countB && countA > countC && countA > countD)
        cout << "Most selected: A";
    else if(countB > countA && countB > countC && countB > countD)
        cout << "Most selected: B";
    else if(countC > countA && countC > countB && countC > countD)
        cout << "Most selected: C";
    else
        cout << "Most selected: D";

    return 0;
}


