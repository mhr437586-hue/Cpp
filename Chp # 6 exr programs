Program no.9

#include <iostream>
using namespace std;

int main() {
    int n, num, sum, digit;

    cout << "Enter limit: ";
    cin >> n;

    for(int i = 1; i <= n; i++) {
        num = i;
        sum = 0;

        while(num > 0) {
            digit = num % 10;
            sum += digit * digit * digit;
            num /= 10;
        }

        if(sum == i)
            cout << i << " ";
    }

    return 0;
}


