Program no.23
          Print series 8, 12, 17, 24, 33, …, 100

#include<iostream>
using namespace std;
int main() {
    int term = 8;
    int diff = 4;  // first difference
    while(term <= 100) {
        cout << term << " ";
        term += diff;
        diff += 1;  // difference increases by 1 each step
    }
    return 0;
}


Program no.25
          Sum series 30 + 33 + 36 + 39 + ... + 60

