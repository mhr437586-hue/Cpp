// 34. GCD of three numbers
int gcd(int a, int b) {
    return b == 0 ? a : gcd(b, a % b);
}
void program34() {
    int a, b, c;
    cin >> a >> b >> c;
    cout << "GCD = " << gcd(gcd(a, b), c) << endl;
}

// 35. Check even, odd, and prime until negative number
bool isPrime(int n) {
    if (n < 2) return false;
    for (int i = 2; i <= sqrt(n); i++)
        if (n % i == 0) return false;
    return true;
}
void program35() {
    int n, even = 0, odd = 0, prime = 0;
    while (true) {
        cin >> n;
        if (n < 0) break;
        if (n % 2 == 0) even++; else odd++;
        if (isPrime(n)) prime++;
    }
    cout << "Even=" << even << " Odd=" << odd << " Prime=" << prime << endl;
}

