// 41. Palindromic primes between 100 and 500
bool isPalindrome(int n) {
    int rev = 0, temp = n;
    while (n) {
        rev = rev * 10 + n % 10;
        n /= 10;
    }
    return rev == temp;
}
void program41() {
    for (int i = 100; i <= 500; i++)
        if (isPrime(i) && isPalindrome(i)) cout << i << " ";
    cout << endl;
}

