using namespace std;

int main() {
    int n, fact;
    char choice;

    do {
        cout << "Enter number: ";
        cin >> n;

        fact = 1;
        for(int i = 1; i <= n; i++)
            fact *= i;

        cout << "Factorial = " << fact << endl;

        cout << "Again? (1 for Yes, 0 for No): ";
        cin >> choice;

    } while(choice == '1');

    return 0;
}


Program no.15

#include <iostream>
using namespace std;

int main() {
    int n, i, flag = 1;

    cout << "Enter number: ";
    cin >> n;

    if(n <= 1) flag = 0;

    for(i = 2; i < n; i++) {
        if(n % i == 0) {
            flag = 0;
            break;
        }
    }

    if(flag == 1)
        cout << "Prime Number";
    else
        cout << "Not Prime";

    return 0;
}


