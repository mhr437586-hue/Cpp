#include <iostream>
using namespace std;

int main() {
    int arr[10], count = 0;

    cout << "Enter 10 integers:\n";
    for(int i = 0; i < 10; i++)
        cin >> arr[i];

    for(int i = 0; i < 10; i++) {
        int n = arr[i];
        int prime = 1;

        if(n <= 1)
            prime = 0;
        else {
            for(int j = 2; j < n; j++) {
                if(n % j == 0) {
                    prime = 0;
                    break;
                }
            }
        }

        if(prime == 1)
            count++;
    }

    cout << "Total prime numbers = " << count;
    return 0;
}
