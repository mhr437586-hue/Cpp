#include <iostream>
using namespace std;

int main() {
    int stars = 1;

    for(int i = 1; i <= 6; i++) {
        for(int j = 1; j <= stars; j++) {
            cout << "*";
        }
        cout << endl;
        stars += 2;
    }

    return 0;
}



