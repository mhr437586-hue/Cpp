3rd program:

//Ek program banao jo check kare:
   Number Positive / Negative / Zero
   Number Even / Odd


#include<iostream>
using namespace std;
int main() {
    int n;
    cout<<"Enter the number";
    cin>>n;

    // Positive / Negative / Zero

    if(n==0)
    cout<<"the number is zero"<< endl;;
    else if(n>0)
    cout<<"the number is positive"<< endl;;
    else
     cout<<"the number is negative"<< endl;;

     // Even / Odd (skip zero)

    if(n!=0){
      if(n%2==0)
     cout<<"the number is even"<< endl;;
     else
     cout<<"the number is odd";
    }
    return 0;
}


4th program:

//User se marks (0–100) input lo aur print karo grade:
   80–100 → A+
   60–79 → B
   40–59 → C
   0–39 → Fail
 Extra:
   Agar marks >100 ya <0 → "Invalid marks" print karo


#include<iostream>
using namespace std;
int main() {
    
int marks;
    cout<<"Enter Marks";
    cin>>marks;

  if(marks < 0 || marks > 100)
        cout << "Invalid marks";
    else if(marks>=80)
      cout<<"Grade is A+";
    else if(marks>=60) 
      cout<<"Grade is B+";
    else if(marks>=40) 
      cout<<"Grade is C";
    else
      cout<<"Grade is Fail";
    return 0;
}


