1st program:

//User se number lo
   Agar number 0 ho → "Zero."
   Agar >0 → "Positive"
   Warna → "Negative."


#include<iostream>
#include <cmath>
using namespace std;
int main()
{
 int n;
 cout<<"Enter the number";
 cin>>n;
 if(n==0)
 cout<<"the no. is zero";
 else if(n>0)
 cout<<"the no. is positive";
 else
 cout<<"the no is negative";
return 0;
}


